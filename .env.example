# Budget settings. Copy this file to:
#   ~/Library/Application Support/Budget/.env
# then quit and reopen Budget. Every value is optional.

# Lets the app ask Claude to guess categories for merchants it doesn't know.
# Without it, unknown merchants are marked "Uncategorized" and you pick.
ANTHROPIC_API_KEY=

# Secret token for the quick-add API (iPhone Shortcut). Leave empty to disable it.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
QUICKADD_TOKEN=

# Phone access: set to 1 so your iPhone (same Wi-Fi) can reach the quick-add API.
# The app then listens on BUDGET_PORT instead of a random port. Other devices can
# still only use quick-add; the dashboard stays on this Mac.
BUDGET_LAN=0
BUDGET_PORT=8000
